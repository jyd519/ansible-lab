{{ ansible_managed | comment }}

{% if alertmanager_tls_cert_file | length > 0 and alertmanager_tls_key_file | length > 0 %}
tls_server_config:
  cert_file: {{ alertmanager_tls_cert_file }}
  key_file: {{ alertmanager_tls_key_file }}
{% endif %}

{% if alertmanager_basic_auth_users | length > 0 %}
basic_auth_users:
{% for u in alertmanager_basic_auth_users %}
  {{ u }}
{% endfor %}
{% endif %}

